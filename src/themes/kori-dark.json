{
 "name": "kori-dark",
 "type": "dark",
 "colors": {
  "editor.background": "#0f1a2e",
  "editor.foreground": "#e5ecf7"
 },
 "tokenColors": [
  {
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#6b7a94",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "keyword",
    "storage",
    "storage.type",
    "keyword.operator.new"
   ],
   "settings": {
    "foreground": "#75b7ff"
   }
  },
  {
   "scope": [
    "string",
    "string.quoted",
    "punctuation.definition.string"
   ],
   "settings": {
    "foreground": "#bbd8ff"
   }
  },
  {
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call"
   ],
   "settings": {
    "foreground": "#8fb0ff"
   }
  },
  {
   "scope": [
    "entity.name.type",
    "support.type",
    "entity.name.class",
    "storage.type.go"
   ],
   "settings": {
    "foreground": "#9fc6ff"
   }
  },
  {
   "scope": [
    "constant.numeric",
    "constant.language",
    "constant.other"
   ],
   "settings": {
    "foreground": "#bbd8ff"
   }
  },
  {
   "scope": [
    "variable",
    "variable.other"
   ],
   "settings": {
    "foreground": "#e5ecf7"
   }
  },
  {
   "scope": [
    "entity.name.tag",
    "support.type.property-name",
    "meta.mapping.key",
    "entity.other.attribute-name"
   ],
   "settings": {
    "foreground": "#75b7ff"
   }
  },
  {
   "scope": [
    "punctuation",
    "keyword.operator"
   ],
   "settings": {
    "foreground": "#a9b6cc"
   }
  }
 ]
}