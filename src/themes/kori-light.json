{
 "name": "kori-light",
 "type": "light",
 "colors": {
  "editor.background": "#f5f8ff",
  "editor.foreground": "#17243b"
 },
 "tokenColors": [
  {
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#6b7a94",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "keyword",
    "storage",
    "storage.type",
    "keyword.operator.new"
   ],
   "settings": {
    "foreground": "#315bff"
   }
  },
  {
   "scope": [
    "string",
    "string.quoted",
    "punctuation.definition.string"
   ],
   "settings": {
    "foreground": "#1a3299"
   }
  },
  {
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call"
   ],
   "settings": {
    "foreground": "#2448d6"
   }
  },
  {
   "scope": [
    "entity.name.type",
    "support.type",
    "entity.name.class",
    "storage.type.go"
   ],
   "settings": {
    "foreground": "#26364f"
   }
  },
  {
   "scope": [
    "constant.numeric",
    "constant.language",
    "constant.other"
   ],
   "settings": {
    "foreground": "#1a3299"
   }
  },
  {
   "scope": [
    "variable",
    "variable.other"
   ],
   "settings": {
    "foreground": "#17243b"
   }
  },
  {
   "scope": [
    "entity.name.tag",
    "support.type.property-name",
    "meta.mapping.key",
    "entity.other.attribute-name"
   ],
   "settings": {
    "foreground": "#315bff"
   }
  },
  {
   "scope": [
    "punctuation",
    "keyword.operator"
   ],
   "settings": {
    "foreground": "#4c5b75"
   }
  }
 ]
}