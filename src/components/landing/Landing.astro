---
import { Code } from 'astro:components';
import { Icon } from 'astro-icon/components';
import Menu from '../ui/Menu.astro';
import { locales } from '../../i18n';
import koriDark from '../../themes/kori-dark.json';
import '../../styles/tokens.css';
import mark from '../../assets/kori-mark.svg?url';
import { copy, type Lang } from './copy';
import { before, after, chi, oaGo, oaYaml } from './snippets';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const b = t.base;
const install = 'go get github.com/douglasmai4/kori';
const theme = koriDark as any;
const beforeLines = before.split('\n').length;
const afterLines = after.split('\n').length;
---
<!doctype html>
<html lang={lang} data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t.title}</title>
  <meta name="description" content={t.description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" hreflang="en" href="/" />
  <link rel="alternate" hreflang="pt-BR" href="/pt-br/" />
  <script is:inline>
    (() => {
      const s = localStorage.getItem('starlight-theme');
      const t = s === 'light' || s === 'dark' ? s : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      document.documentElement.dataset.theme = t;
    })();
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <section class="hero">
    <header class="nav wrap">
      <a class="brand" href={`${b}/`} aria-label="kori">
        <img src={mark} alt="" width="30" height="30" />
        <span>kori</span>
      </a>
      <nav aria-label="Primary">
        <a href={`${b}/introduction/`}>{t.nav.docs}</a>
        <a class="hide-sm" href={`${b}/guides/authentication/`}>{t.nav.guides}</a>
        <a class="hide-sm" href={`${b}/reference/kori/`}>{t.nav.reference}</a>
        <a href="https://github.com/douglasmai4/kori" class="ext">GitHub
          <Icon name="hugeicons:arrow-up-right-01" aria-hidden="true" />
        </a>
        <div class="lang"><Menu label={t.nav.lang} icon="hugeicons:translate" items={locales.map((l) => ({ label: l.label, lang: l.lang, href: `${l.prefix}/`, current: l.lang === lang }))} /></div>
        <button class="theme" type="button" aria-label={t.nav.theme}>
          <Icon name="hugeicons:sun-03" class="sun" aria-hidden="true" />
          <Icon name="hugeicons:moon-02" class="moon" aria-hidden="true" />
        </button>
      </nav>
    </header>

    <div class="hero-body wrap" id="main">
      <div class="hero-copy">
        <h1><span>{t.h1a}</span><br /><em>{t.h1b}</em></h1>
        <p class="lede">{t.lede}</p>
        <div class="actions">
          <a class="btn" href={`${b}/getting-started/installation/`}>{t.cta}
            <Icon name="hugeicons:arrow-right-02" aria-hidden="true" />
          </a>
          <button class="install" type="button" data-copy={install} aria-label={t.copy}>
            <code><span class="dollar">$</span> {install}</code>
            <span class="copy-state" data-done={t.copied}>
              <Icon name="hugeicons:copy-01" aria-hidden="true" />
            </span>
          </button>
        </div>
      </div>
      <div class="slabs" aria-hidden="true">
        <span class="slab s1"></span>
        <span class="slab s2"></span>
        <span class="slab s3"></span>
      </div>
    </div>
  </section>

  <main>
    <section class="diff wrap">
      <div class="sec-head">
        <h2>{t.diffTitle}</h2>
        <p>{t.diffBody}</p>
      </div>
      <div class="window diff-window" data-state="before">
        <div class="bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <div class="seg" role="tablist" aria-label="Handler comparison">
            <button role="tab" type="button" aria-selected="true" data-to="before">{t.without}</button>
            <button role="tab" type="button" aria-selected="false" data-to="after">{t.with}</button>
          </div>
          <span class="count" aria-live="polite"><b data-before={beforeLines} data-after={afterLines}>{beforeLines}</b> {t.lines}</span>
        </div>
        <div class="panes">
          <div class="pane" data-pane="before"><Code code={before} lang="go" theme={theme} /></div>
          <div class="pane" data-pane="after" hidden><Code code={after} lang="go" theme={theme} /></div>
        </div>
      </div>
      <p class="note">{t.diffNote}</p>
    </section>

    <section class="chi">
      <div class="wrap chi-grid">
        <div>
          <h2>{t.chiTitle}</h2>
          <p>{t.chiBody}</p>
          <ul>{t.chiPoints.map((p) => <li>{p}</li>)}</ul>
        </div>
        <div class="window">
          <div class="bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="file">main.go</span></div>
          <Code code={chi} lang="go" theme={theme} />
        </div>
      </div>
    </section>

    <section class="api wrap">
      <div class="sec-head">
        <h2>{t.apiTitle}</h2>
        <p>{t.apiBody} <a href={`${b}/reference/kori/`}>{t.apiAll} <Icon name="hugeicons:arrow-right-02" class="arr" aria-hidden="true" /></a></p>
      </div>
      <dl class="api-list">
        {t.api.map(([group, names, desc]) => (
          <div class="api-row">
            <dt>{group}</dt>
            <dd><code>{names}</code><span>{desc}</span></dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="oa wrap">
      <div class="sec-head">
        <h2>{t.oaTitle}</h2>
        <p>{t.oaBody} <a href={`${b}/openapi/`}>{t.oaLink} <Icon name="hugeicons:arrow-right-02" class="arr" aria-hidden="true" /></a></p>
      </div>
      <div class="oa-pair">
        <div class="window">
          <div class="bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="file">users.go</span></div>
          <Code code={oaGo} lang="go" theme={theme} />
        </div>
        <Icon name="hugeicons:arrow-right-02" class="oa-arrow" aria-hidden="true" />
        <div class="window">
          <div class="bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="file">openapi.yaml</span></div>
          <Code code={oaYaml} lang="yaml" theme={theme} />
        </div>
      </div>
    </section>

    <section class="close">
      <div class="wrap close-inner">
        <img src={mark} alt="" width="72" height="72" />
        <h2>{t.closeTitle}</h2>
        <p>{t.closeBody}</p>
        <div class="actions center">
          <button class="install" type="button" data-copy={install} aria-label={t.copy}>
            <code><span class="dollar">$</span> {install}</code>
            <span class="copy-state" data-done={t.copied}>
              <Icon name="hugeicons:copy-01" aria-hidden="true" />
            </span>
          </button>
          <a class="btn" href={`${b}/introduction/`}>{t.closeCta}
            <Icon name="hugeicons:arrow-right-02" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot wrap">
    <span class="brand small"><img src={mark} alt="" width="20" height="20" /> kori</span>
    <span>{t.tagline}</span>
    <span>{t.footer}</span>
  </footer>

  <script>
    const root = document.documentElement;
    document.querySelector('.theme')?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      localStorage.setItem('starlight-theme', next);
    });

    document.querySelectorAll<HTMLButtonElement>('.install').forEach((btn) => {
      btn.addEventListener('click', async () => {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.classList.add('done');
        setTimeout(() => btn.classList.remove('done'), 1600);
      });
    });

    const win = document.querySelector<HTMLElement>('.diff-window');
    if (win) {
      const panes = win.querySelector<HTMLElement>('.panes')!;
      const count = win.querySelector<HTMLElement>('.count b')!;
      const tabs = win.querySelectorAll<HTMLButtonElement>('[data-to]');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let touched = false;

      const tick = (from: number, to: number) => {
        if (reduce) { count.textContent = String(to); return; }
        const start = performance.now();
        const step = (now: number) => {
          const p = Math.min(1, (now - start) / 700);
          const e = 1 - Math.pow(1 - p, 4);
          count.textContent = String(Math.round(from + (to - from) * e));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };

      const show = (to: 'before' | 'after') => {
        if (win.dataset.state === to) return;
        const from = win.dataset.state as 'before' | 'after';
        const cur = panes.querySelector<HTMLElement>(`[data-pane="${from}"]`)!;
        const next = panes.querySelector<HTMLElement>(`[data-pane="${to}"]`)!;
        panes.style.height = `${panes.offsetHeight}px`;
        next.hidden = false;
        const h = next.offsetHeight;
        cur.hidden = true;
        requestAnimationFrame(() => { panes.style.height = `${h}px`; });
        win.dataset.state = to;
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.to === to)));
        tick(Number(count.dataset[from]), Number(count.dataset[to]));
      };

      panes.addEventListener('transitionend', () => { panes.style.height = ''; });
      tabs.forEach((t) => t.addEventListener('click', () => { touched = true; show(t.dataset.to as 'before' | 'after'); }));

      new IntersectionObserver((entries, obs) => {
        if (entries[0].isIntersecting) {
          obs.disconnect();
          setTimeout(() => { if (!touched) show('after'); }, reduce ? 0 : 1400);
        }
      }, { threshold: 0.6 }).observe(win);
    }
  </script>
</body>
</html>

<style is:global>
  :root {
    --bg: var(--kori-snow); --bg-2: var(--kori-mist); --ink: var(--kori-night); --ink-2: #3e4d68; --line: #dbe3f0; --accent: var(--kori-primary); --emph: var(--kori-primary);
    color-scheme: light;
  }
  :root[data-theme='dark'] {
    --bg: var(--kori-night); --bg-2: #111c30; --ink: #f5f8ff; --ink-2: #a9b6cc; --line: #22324c; --accent: #5b8bff; --emph: var(--kori-crystal);
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--kori-font); font-size: 1.0625rem; line-height: 1.6; -webkit-font-smoothing: antialiased; }
  ::selection { background: color-mix(in oklab, var(--kori-crystal) 45%, transparent); }
  :focus-visible { outline: 2px solid var(--kori-crystal); outline-offset: 3px; border-radius: 6px; }
  a { color: inherit; }
  .wrap { width: min(100% - 3rem, 76rem); margin-inline: auto; }
  .skip { position: absolute; left: -999px; top: 0; }
  .skip:focus { left: 1rem; top: 1rem; z-index: 10; background: #fff; color: var(--kori-night); padding: .5rem .75rem; border-radius: 8px; }
  h1, h2 { text-wrap: balance; margin: 0; }
  h2 { font-size: clamp(1.9rem, 3.4vw, 2.75rem); line-height: 1.08; letter-spacing: -0.035em; font-weight: 640; }
  p { text-wrap: pretty; }

  /* Hero — always Night, per brand mock */
  .hero { position: relative; overflow: hidden; color: #f5f8ff; background:
      radial-gradient(60rem 40rem at 85% 55%, rgb(49 91 255 / .28), transparent 60%),
      linear-gradient(180deg, #0d1526 0%, #111d36 100%);
    border-bottom: 1px solid #1d2b44; }
  .nav { display: flex; align-items: center; justify-content: space-between; padding-block: 1.4rem; position: relative; z-index: 2; }
  .brand { display: inline-flex; align-items: center; gap: .55rem; text-decoration: none; font-weight: 620; font-size: 1.45rem; letter-spacing: -0.04em; }
  .brand.small { font-size: 1rem; gap: .4rem; }
  .nav nav { display: flex; align-items: center; gap: 2rem; font-size: .95rem; }
  .nav nav a { text-decoration: none; color: #d7e0ef; transition: color .2s; }
  .nav nav a:hover { color: #fff; }
  .ext { display: inline-flex; align-items: center; gap: .3rem; }
  .ext svg { width: .8rem; height: .8rem; }
  .lang { --menu-fg: #d7e0ef; --menu-fg-strong: #fff; --menu-hover: rgb(255 255 255 / .07); --menu-bg: rgb(17 28 48 / .92); --menu-line: #22324c; --menu-accent: var(--kori-crystal); }
  .theme { background: none; border: 0; color: #d7e0ef; cursor: pointer; width: 2.25rem; height: 2.25rem; display: grid; place-items: center; border-radius: 8px; }
  .theme:hover { color: #fff; background: rgb(255 255 255 / .06); }
  .theme svg { width: 1.2rem; height: 1.2rem; grid-area: 1 / 1; transition: opacity .3s, transform .5s var(--kori-ease); }
  [data-theme='dark'] .theme .moon, [data-theme='light'] .theme .sun { opacity: 0; transform: rotate(-60deg) scale(.6); }

  .hero-body { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); min-height: min(42rem, calc(100svh - 5rem)); align-items: center; padding-block: 3rem 6rem; }
  .hero-copy { position: relative; z-index: 2; max-width: 46rem; }
  .hero h1 span { white-space: nowrap; }
  .hero h1 { font-size: clamp(3rem, 7.4vw, 5.5rem); line-height: .98; letter-spacing: -0.04em; font-weight: 660; }
  .hero h1 em { font-style: normal; color: var(--kori-crystal); }
  .lede { font-size: clamp(1.08rem, 1.5vw, 1.25rem); color: #b9c5d9; max-width: 32rem; margin: 1.75rem 0 2.5rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .85rem; align-items: center; }
  .actions.center { justify-content: center; }
  .btn { display: inline-flex; align-items: center; gap: .55rem; height: 3rem; padding: 0 1.35rem; font-size: 1rem; border-radius: 10px; text-decoration: none; font-weight: 560; color: var(--kori-night);
    background: linear-gradient(120deg, #75b7ff, #4f8cff); box-shadow: 0 6px 16px -6px rgb(13 21 38 / .55), inset 0 1px 0 rgb(255 255 255 / .25); transition: transform .3s var(--kori-ease), box-shadow .3s; }
  .btn svg { width: 1rem; height: 1rem; transition: transform .3s var(--kori-ease); }
  .btn:hover { transform: translateY(-1px); box-shadow: 0 10px 22px -8px rgb(13 21 38 / .6), inset 0 1px 0 rgb(255 255 255 / .25); }
  .btn:hover svg { transform: translateX(3px); }
  .install { display: inline-flex; align-items: center; gap: .75rem; height: 3rem; padding: 0 .9rem 0 1.1rem; border-radius: 10px; cursor: pointer; font: inherit;
    background: rgb(255 255 255 / .04); border: 1px solid #2a3b58; color: #d7e0ef; transition: border-color .2s, background .2s; }
  .install:hover { border-color: #3d5378; background: rgb(255 255 255 / .07); }
  .install code { font-family: var(--kori-mono); font-size: .88rem; }
  .dollar { color: var(--kori-steel); user-select: none; }
  .copy-state { position: relative; display: grid; place-items: center; width: 1.1rem; }
  .copy-state svg { width: 1rem; height: 1rem; transition: opacity .2s; }
  .copy-state::after { content: attr(data-done); position: absolute; right: -0.2rem; top: -2.3rem; font-size: .75rem; padding: .2rem .5rem; border-radius: 6px; background: var(--kori-crystal); color: var(--kori-night); opacity: 0; transform: translateY(4px); transition: opacity .2s, transform .3s var(--kori-ease); pointer-events: none; white-space: nowrap; }
  .install.done .copy-state::after { opacity: 1; transform: none; }

  .slabs { position: absolute; inset: 0 -12% 0 auto; width: 62%; pointer-events: none; z-index: 1; }
  .slab { position: absolute; display: block; border-radius: 18%; transform: rotate(45deg); border: 1px solid rgb(187 216 255 / .35);
    animation: drift 1.6s var(--kori-ease) both; }
  .s1 { width: 30rem; aspect-ratio: 1; right: 22%; top: 2%; background: linear-gradient(135deg, rgb(117 183 255 / .18), rgb(49 91 255 / .08)); border-color: rgb(117 183 255 / .25); animation-delay: .05s; }
  .s2 { width: 26rem; aspect-ratio: 1; right: 4%; top: 30%; background: linear-gradient(120deg, #bbd8ff 0%, #75b7ff 38%, #315bff 100%); opacity: .92; box-shadow: 0 40px 80px -30px rgb(13 21 38 / .9); animation-delay: .15s; }
  .s3 { width: 20rem; aspect-ratio: 1; right: 30%; top: 55%; background: linear-gradient(135deg, rgb(117 183 255 / .55), rgb(49 91 255 / .75)); animation-delay: .25s; }
  @keyframes drift { from { opacity: 0; transform: translate(4rem, 3rem) rotate(38deg) scale(.94); } }

  /* Sections */
  main section { padding-block: clamp(4.5rem, 9vw, 7.5rem); }
  .oa { padding-top: 0 !important; }
  .sec-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem 4rem; align-items: end; margin-bottom: 3rem; }
  .sec-head p { margin: 0; color: var(--ink-2); max-width: 34rem; }
  .arr { width: .85em; height: .85em; vertical-align: -0.08em; }
  .sec-head a { color: var(--emph); text-underline-offset: .22em; text-decoration-thickness: 1px; white-space: nowrap; }

  .window { background: #0f1a2e; border: 1px solid #22324c; border-radius: 14px; overflow: hidden; box-shadow: 0 30px 60px -30px rgb(13 21 38 / .45); color: #e5ecf7; }
  [data-theme='light'] .window { box-shadow: 0 30px 60px -32px rgb(23 36 59 / .35); }
  .bar { display: flex; align-items: center; gap: 1rem; padding: .8rem 1rem; border-bottom: 1px solid #1d2b44; background: #131f36; }
  .dots { display: inline-flex; gap: .45rem; }
  .dots i { width: .7rem; height: .7rem; border-radius: 50%; background: #ff5f57; }
  .dots i:nth-child(2) { background: #febc2e; } .dots i:nth-child(3) { background: #28c840; }
  .file { font-family: var(--kori-mono); font-size: .8rem; color: var(--kori-steel); }
  .window pre.astro-code { margin: 0; padding: 1.25rem 1.4rem; background: transparent !important; font-family: var(--kori-mono); font-size: .86rem; line-height: 1.7; overflow-x: auto; scrollbar-color: #2a3b58 transparent; }

  .seg { display: inline-flex; padding: 3px; border-radius: 9px; background: #0d1526; border: 1px solid #22324c; }
  .seg button { font: inherit; font-size: .85rem; border: 0; background: none; color: #a9b6cc; padding: .35rem .85rem; border-radius: 6px; cursor: pointer; transition: background .3s var(--kori-ease), color .2s; }
  .seg button[aria-selected='true'] { background: #26364f; color: #fff; }
  .diff-window[data-state='after'] .seg button[aria-selected='true'] { background: var(--kori-primary); }
  .count { margin-left: auto; font-size: .85rem; color: var(--kori-steel); font-variant-numeric: tabular-nums; }
  .count b { color: #fff; font-weight: 600; display: inline-block; min-width: 2ch; text-align: right; }
  .panes { overflow: hidden; transition: height .7s var(--kori-ease); }
  .pane:not([hidden]) { animation: pane-in .6s var(--kori-ease); }
  @keyframes pane-in { from { opacity: 0; filter: blur(6px); transform: translateY(6px); } }
  .note { color: var(--ink-2); font-size: .95rem; max-width: 46rem; margin: 1.5rem 0 0; }

  .chi { background: var(--bg-2); border-block: 1px solid var(--line); }
  .chi-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 4rem; align-items: center; }
  .chi-grid p { color: var(--ink-2); margin: 1.25rem 0 1.75rem; }
  .chi-grid ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .9rem; }
  .chi-grid li { display: grid; grid-template-columns: 1.1rem 1fr; gap: .75rem; }
  .chi-grid li::before { content: ''; width: .62rem; height: .62rem; margin-top: .52rem; border-radius: 3px; transform: rotate(45deg); background: var(--kori-crystal); }

  .api-list { margin: 0; border-top: 1px solid var(--line); }
  .api-row { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: 2rem; padding: 1.5rem 0; border-bottom: 1px solid var(--line); transition: background .3s; }
  .api-row dt { font-weight: 600; letter-spacing: -0.01em; }
  .api-row dd { margin: 0; display: grid; gap: .3rem; }
  .api-row code { font-family: var(--kori-mono); font-size: .92rem; color: var(--emph); }
  .api-row span { color: var(--ink-2); }

  .oa-pair { display: grid; grid-template-columns: minmax(0, 1.25fr) 3rem minmax(0, .85fr); align-items: center; gap: 1rem; }
  .oa-arrow { width: 2rem; height: 2rem; justify-self: center; color: var(--kori-crystal); }

  .close { background: linear-gradient(180deg, var(--bg) 0%, var(--bg-2) 100%); text-align: center; }
  .close-inner { display: grid; justify-items: center; }
  .close h2 { margin-top: 1.5rem; }
  .close p { color: var(--ink-2); max-width: 34rem; margin: 1rem 0 2.25rem; }
  .close .install { background: var(--bg); border-color: var(--line); color: var(--ink); }

  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding-block: 2rem; border-top: 1px solid var(--line); color: var(--ink-2); font-size: .88rem; }

  @media (max-width: 960px) {
    .nav nav a.hide-sm { display: none; }
    .sec-head, .chi-grid { grid-template-columns: minmax(0, 1fr); }
    .oa-pair { grid-template-columns: minmax(0, 1fr); }
    .oa-arrow { transform: rotate(90deg); justify-self: center; }
    .slabs { width: 100%; inset: auto -30% -10% auto; height: 60%; opacity: .5; }
  }
  @media (max-width: 640px) {
    .nav { gap: 1rem; }
    .nav nav { gap: .25rem; }
    .nav nav > a { padding: .4rem .55rem; }
    .ext { display: none !important; }
    .lang .trigger > span { display: none; }
    .hero-body { padding-block: 2rem 4rem; min-height: auto; }
    .actions { display: grid; grid-template-columns: 1fr; }
    .btn, .install { width: 100%; justify-content: center; }
    .install code { font-size: .8rem; }
    .slabs { opacity: .3; }
    .api-row { grid-template-columns: minmax(0, 1fr); gap: .5rem; }
    .install code { font-size: .78rem; }
    .bar { flex-wrap: wrap; }
    .count { margin-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
